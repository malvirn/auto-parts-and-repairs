{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "centric-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "vars": {
    "SUPABASE_URL": "https://pztwmmkmkyotszylbhsr.supabase.co",
    "CORS_ORIGINS": "https://centric-auto-mobile.pages.dev"
  },
  "alias": {
    "class-validator": "./src/worker-unused-optional.ts",
    "class-transformer": "./src/worker-unused-optional.ts",
    "@nestjs/microservices": "./src/worker-unused-optional.ts",
    "@nestjs/microservices/microservices-module.js": "./src/worker-unused-optional.ts",
    "@nestjs/websockets": "./src/worker-unused-optional.ts",
    "@nestjs/websockets/socket-module.js": "./src/worker-unused-optional.ts"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "secrets": {
    "required": [
      "SUPABASE_PUBLISHABLE_KEY"
    ]
  }
}
