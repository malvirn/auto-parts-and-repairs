{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "centric-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
