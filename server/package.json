{
  "name": "centric-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "dev:worker": "wrangler dev --local",
    "deploy:worker": "wrangler deploy",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.168.0"
  }
}
