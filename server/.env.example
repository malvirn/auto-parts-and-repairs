# Supabase project URL and publishable key only.
# Never place a service-role key or secret key in this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Port provided by your hosting platform, or 3000 locally.
PORT=3000

# Comma-separated exact HTTPS origins allowed to call the API.
# Leave empty until the deployed frontend origin is confirmed.
CORS_ORIGINS=
